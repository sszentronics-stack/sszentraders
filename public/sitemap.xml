<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 16 — static sitemap. Lists every static storefront route. Product
  detail pages (/products/:slug) are intentionally NOT enumerated here:
  they're backend-driven (Phase 3) and this repo has no live Supabase
  project in this dev environment to read the published catalog from at
  build time, so a dynamic per-product sitemap can't be generated
  correctly here. Before going live, either (a) wire a small build-time
  script that queries `products` (status='published') and appends
  <url> entries, or (b) serve a dynamic /sitemap.xml from a Supabase Edge
  Function. Search engines will still discover product pages via on-site
  links (Shop grid, category pages) regardless.

  Replace the https://www.aurabeautycare.pk placeholder host below with
  the real production domain before deploying.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://www.aurabeautycare.pk/</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  <url><loc>https://www.aurabeautycare.pk/shop</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>https://www.aurabeautycare.pk/about</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
  <url><loc>https://www.aurabeautycare.pk/contact</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
  <url><loc>https://www.aurabeautycare.pk/privacy</loc><changefreq>yearly</changefreq><priority>0.2</priority></url>
  <url><loc>https://www.aurabeautycare.pk/shipping</loc><changefreq>yearly</changefreq><priority>0.2</priority></url>
  <url><loc>https://www.aurabeautycare.pk/refund</loc><changefreq>yearly</changefreq><priority>0.2</priority></url>
  <url><loc>https://www.aurabeautycare.pk/terms</loc><changefreq>yearly</changefreq><priority>0.2</priority></url>
</urlset>
