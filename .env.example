# Aura Beauty Care — authoritative environment variable template.
#
# This is the ONE central configuration contract for the whole project
# (Vite storefront + Supabase Edge Functions). All values are blank —
# never commit real credentials, never invent sample/production keys.
#
# - Variables prefixed VITE_ are the ONLY ones exposed to browser code
#   (Vite's own convention — see vite.config.js / src/lib/config/env.ts).
#   Copy the VITE_* subset into `.env.local` for local `npm run dev`.
# - All other variables are SERVER-ONLY and must never be prefixed VITE_.
#   They belong to Supabase Edge Functions and are set with
#   `supabase secrets set NAME=value` (or the Supabase dashboard's Edge
#   Function secrets UI) — never in a Vite `.env` file, never in this repo.
# - backend/config/.env.example intentionally just points back to this
#   file, to avoid two divergent copies of the same contract.

# --- App (client-safe) -------------------------------------------------
VITE_APP_ENV=
VITE_APP_URL=
VITE_WHATSAPP_SUPPORT_NUMBER=

# --- Supabase — client-safe (Vite) --------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase — server-only (Edge Functions) -----------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LedGix ERP (server-only, Edge Functions) -----------------------------
LEDGIX_API_BASE_URL=
LEDGIX_API_KEY=
LEDGIX_COMPANY_ID=

# --- Easypaisa (server-only, Edge Functions) ------------------------------
EASYPAISA_MERCHANT_ID=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_API_BASE_URL=
EASYPAISA_WEBHOOK_SECRET=

# --- Leopards Courier (server-only, Edge Functions) ------------------------
LEOPARDS_API_KEY=
LEOPARDS_API_PASSWORD=
LEOPARDS_API_BASE_URL=
LEOPARDS_WEBHOOK_SECRET=

# --- Email / SMTP (server-only, Edge Functions) ---------------------------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Future WhatsApp Business API (server-only, Edge Functions) ------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Future OAuth (client-safe app id + server-only secret) ----------------
VITE_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
VITE_APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# --- Misc (server-only, Edge Functions) ------------------------------------
LOG_LEVEL=
